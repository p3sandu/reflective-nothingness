max-history=5
markup=1
actions=1
history=1
sort=+time

on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-notify=exec mpv --volume=100 /usr/share/sounds/freedesktop/stereo/message.oga

font=JetBrainsMono Nerd Font 10
background-color=#1f1f28e6
text-color=#dcd7ba

margin=15
padding=15
border-radius=8
border-color=#7e9cd8
border-size=2

icons=1
max-icon-size=48
icon-location=left
format=<b>%s</b>\n%b
anchor=top-right
layer=overlay

[urgency=low]
border-color=#54546d
default-timeout=5000

[urgency=normal]
border-color=#7e9cd8
default-timeout=10000

[urgency=critical]
border-color=#e82424
text-color=#e6c384
default-timeout=30000
